---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Section musée : accent indigo. Le fond reste blanc. */
  musee?: boolean;
  /** Image Open Graph (URL absolue ou chemin depuis la racine). */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, musee = false, image = '/logo-comengangte.png', type = 'website' } = Astro.props;
const titreComplet = title === site.nom ? `${site.nom} · ${site.nomLong}` : `${title} · ${site.nom}`;
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(chemin, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr" class:list={[{ musee }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-encre antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-vert focus:px-5 focus:py-3 focus:text-white"
      >{t('nav.skip')}</a
    >
    <Header musee={musee} />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
