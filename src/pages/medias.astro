---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import VideoLazy from '../components/VideoLazy.astro';
import NdopBand from '../components/NdopBand.astro';

const congres = import.meta.glob<ImageMetadata>('/src/assets/congres/*.jpeg', { eager: true, import: 'default' });
const photos = Object.entries(congres)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, img]) => img);
const videos = [
  { src: '/videos/congres-passe-01.mp4', titre: 'Vidéo des congrès passés 1', portrait: true },
  { src: '/videos/congres-passe-02.mp4', titre: 'Vidéo des congrès passés 2', portrait: true },
  { src: '/videos/congres-passe-03.mp4', titre: 'Vidéo des congrès passés 3', portrait: true },
  { src: '/videos/congres-passe-04.mp4', titre: 'Vidéo des congrès passés 4', portrait: false },
  { src: '/videos/congres-passe-05.mp4', titre: 'Vidéo des congrès passés 5', portrait: true },
];
---

<Base title="Médias" description="Reportage CRTV du 17 novembre 2026, galerie « Mémoire des congrès » et vidéos des congrès passés.">
  <PageHero eyebrow="Médias" titre="Reportage, photos et vidéos" lead="Le passage télévisé du 17 novembre 2026 et la mémoire des congrès précédents." />

  <section class="wrap pb-16 sm:pb-24" aria-labelledby="crtv">
    <h2 id="crtv" class="titre text-2xl sm:text-3xl">Reportage CRTV, 17 novembre 2026</h2>
    <div class="mt-6">
      <VideoLazy src="/videos/reportage-crtv-2026-11-17.mp4" titre="Reportage CRTV du 17 novembre 2026" legende="Reportage diffusé sur la CRTV le 17 novembre 2026." />
    </div>
  </section>

  <NdopBand hauteur={20} />

  <section class="wrap section-tight" id="galerie" aria-labelledby="galerie-titre">
    <p class="eyebrow">Mémoire des congrès</p>
    <h2 id="galerie-titre" class="titre mt-2 text-3xl sm:text-4xl">Galerie</h2>
    <p class="mt-3 text-muted">Photos des congrès précédents. Auteurs et dates à préciser.</p>
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
      {
        photos.map((p, i) => (
          <li>
            <Image src={p} alt={`Mémoire des congrès, photo ${i + 1} sur ${photos.length}.`} widths={[300, 450, 600]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover" loading={i < 4 ? 'eager' : 'lazy'} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section-tight border-t border-trait" aria-labelledby="videos">
    <p class="eyebrow">Vidéos</p>
    <h2 id="videos" class="titre mt-2 text-3xl sm:text-4xl">Les congrès en images animées</h2>
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
      {
        videos
          .filter((v) => v.portrait)
          .map((v) => (
            <li>
              <VideoLazy src={v.src} titre={v.titre} portrait legende={v.titre} />
            </li>
          ))
      }
    </ul>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {
        videos
          .filter((v) => !v.portrait)
          .map((v) => (
            <li>
              <VideoLazy src={v.src} titre={v.titre} legende={v.titre} />
            </li>
          ))
      }
    </ul>
  </section>
</Base>
