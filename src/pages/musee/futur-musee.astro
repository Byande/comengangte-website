---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../config/site';
import palais1 from '../../assets/lieux/ancien-palais-royal-1.jpg';
import palais2 from '../../assets/lieux/ancien-palais-royal-2.jpg';

const engagements = [
  { titre: 'Préserver', texte: 'Conserver les objets inventoriés et le bâtiment qui les accueillera.' },
  { titre: 'Transmettre', texte: 'Raconter l’histoire des objets aux jeunes générations, ici et dans la diaspora.' },
  { titre: 'Rayonner', texte: 'Faire connaître le patrimoine Bangangté au Cameroun et dans le monde.' },
];
---

<Base title="Le futur musée" description="Le projet de musée de la chefferie Bangangté dans l’ancien palais royal : Préserver, Transmettre, Rayonner." musee>
  <PageHero eyebrow="Musée numérique" titre="Le futur musée" lead="L’ancien palais royal, à l’entrée de la cour de la chefferie, accueillera le musée de la chefferie Bangangté." />

  <div class="wrap">
    <Image src={palais2} alt="L’ancien palais royal de Bangangté, vu de face, avec des visiteurs sur l’esplanade." widths={[640, 960, 1280, 1600]} sizes="(min-width: 1152px) 1152px, 100vw" class="aspect-[16/9] w-full rounded-sm object-cover sm:aspect-[21/9]" loading="eager" />
  </div>

  <section class="wrap section-tight grid gap-10 md:grid-cols-2 md:gap-14">
    <div class="prose-site">
      <h2 class="text-2xl sm:text-3xl">L’ancien palais royal</h2>
      <p>De construction coloniale allemande, le bâtiment offre environ 369 m² exploitables. Il porte la mémoire d’une hybridation entre les traditions locales et les apports européens.</p>
      <p>Le patrimoine bâti de la chefferie comprend aussi la maison de la Reine blanche.</p>
      <p>L’édition {site.edition.annee} du congrès contribue à réunir les fonds nécessaires au musée.</p>
      <p><a href="/soutenir" class="btn-primary no-underline">Soutenir le musée</a></p>
    </div>
    <Image src={palais1} alt="Façade de l’ancien palais royal : pierres sombres jointoyées de blanc, fenêtres en arc, statue devant l’entrée." widths={[400, 600, 800]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
  </section>

  <section class="border-t border-trait" aria-labelledby="engagements">
    <div class="wrap section-tight">
      <h2 id="engagements" class="text-2xl sm:text-3xl">Trois engagements</h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-3">
        {
          engagements.map((e, i) => (
            <li>
              <p class="font-serif text-sm text-ndop">0{i + 1}</p>
              <h3 class="mt-1 text-2xl">{e.titre}</h3>
              <p class="mt-2 text-[0.98rem] leading-relaxed text-muted">{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
