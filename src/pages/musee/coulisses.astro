---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../config/site';

const photos = Object.values(
  import.meta.glob<ImageMetadata>('/src/assets/inventaire/*.jpg', { eager: true, import: 'default' }),
);
---

<Base title="Les coulisses" description="Le travail d’inventaire des objets de la chefferie Bangangté, en photos." musee>
  <PageHero eyebrow="Musée numérique" titre="Les coulisses" lead={`Le travail d’inventaire mené par ${site.partenaire.nom} : ${site.musee.objetsInventories} objets documentés, dans un état de conservation relativement bon.`} />

  <section class="wrap pb-20 sm:pb-28">
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:gap-6">
      {
        photos.map((p, i) => (
          <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
            <Image
              src={p}
              alt={`Travail d’inventaire des objets de la chefferie, photo ${i + 1} sur ${photos.length}.`}
              widths={[360, 540, 720, 1080]}
              sizes={i === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 50vw'}
              class="aspect-[3/4] h-full w-full rounded-sm object-cover"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-muted">Photos : inventaire du patrimoine de la chefferie Bangangté, {site.partenaire.nom}, 2026.</p>
  </section>
</Base>
