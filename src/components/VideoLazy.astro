---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Vidéo chargée à la demande : seule l'image d'aperçu est chargée au départ,
 * le fichier vidéo n'est demandé qu'au clic.
 * L'aperçu est cherché dans src/assets/posters/<nom-du-fichier-vidéo>.jpg.
 */
interface Props {
  src: string;
  titre: string;
  legende?: string;
  /** Vidéo verticale (téléphone) : cadre 9/16 au lieu de 16/9. */
  portrait?: boolean;
}
const { src, titre, legende, portrait = false } = Astro.props;
const posters = import.meta.glob<ImageMetadata>('/src/assets/posters/*.jpg', { eager: true, import: 'default' });
const nom = src.split('/').pop()?.replace(/\.[^.]+$/, '');
const poster = Object.entries(posters).find(([p]) => p.endsWith(`/${nom}.jpg`))?.[1];
---

<figure class="video-lazy" data-src={src}>
  <div class:list={['relative overflow-hidden bg-gris', portrait ? 'aspect-[9/16]' : 'aspect-video']}>
    {poster && <Image src={poster} alt="" widths={portrait ? [360, 540, 720] : [640, 960, 1280]} sizes={portrait ? '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 60vw, 100vw'} class="h-full w-full object-cover" loading="lazy" data-poster />}
    <video class="hidden h-full w-full bg-black" controls preload="none" playsinline data-video>
      <track kind="captions" />
    </video>
    <button
      type="button"
      class="absolute inset-0 flex items-center justify-center bg-encre/10 transition-colors hover:bg-encre/20"
      data-lire
      aria-label={`Lire la vidéo : ${titre}`}
    >
      <span class="inline-flex min-h-12 items-center gap-3 rounded-full bg-white px-6 py-3 text-[0.95rem] font-semibold text-encre shadow-sm">
        <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true"><path d="M1 1.5v13l12-6.5z" fill="currentColor" /></svg>
        Lire la vidéo
      </span>
    </button>
  </div>
  {legende && <figcaption class="mt-3 text-sm text-muted">{legende}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video-lazy').forEach((fig) => {
    const bouton = fig.querySelector<HTMLButtonElement>('[data-lire]');
    const video = fig.querySelector<HTMLVideoElement>('[data-video]');
    const poster = fig.querySelector<HTMLElement>('[data-poster]');
    if (!bouton || !video) return;
    bouton.addEventListener('click', () => {
      video.src = fig.dataset.src!;
      video.classList.remove('hidden');
      poster?.remove();
      bouton.remove();
      video.play().catch(() => {});
      video.focus();
    });
  });
</script>
