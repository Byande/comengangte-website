---
/**
 * En-tête de page : surtitre, titre, chapeau. Une idée par écran.
 */
interface Props {
  eyebrow?: string;
  titre: string;
  lead?: string;
  narrow?: boolean;
}
const { eyebrow, titre, lead, narrow = true } = Astro.props;
---

<header class:list={['pt-14 pb-10 sm:pt-20 sm:pb-14 lg:pt-28 lg:pb-20', narrow ? 'wrap-narrow' : 'wrap']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl">{titre}</h1>
  {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
  <slot />
</header>
