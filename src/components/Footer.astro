---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-comengangte.png';
import logoRdc from '../assets/logo/logo-route-des-chefferies.jpg';
import NdopBand from './NdopBand.astro';
import { site } from '../config/site';
import { t } from '../i18n/ui';

const colonnes = [
  {
    titre: 'Le site',
    liens: [
      { href: '/congres', label: t('nav.congres') },
      { href: '/chefferie', label: t('nav.chefferie') },
      { href: '/soutenir', label: t('nav.soutenir') },
      { href: '/medias', label: t('nav.medias') },
      { href: '/contact', label: t('nav.contact') },
    ],
  },
  {
    titre: 'Musée numérique',
    liens: [
      { href: '/musee', label: 'Accueil du musée' },
      { href: '/musee/collection', label: t('musee.collection') },
      { href: '/musee/salles/histoire-civilisation-migration', label: t('musee.salles') },
      { href: '/musee/coulisses', label: t('musee.coulisses') },
      { href: '/musee/futur-musee', label: t('musee.futur') },
    ],
  },
];
---

<footer class="mt-auto">
  <NdopBand />
  <div class="bg-vert text-white">
    <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="sm:col-span-2 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-3">
          <Image src={logo} alt={`Logo du ${site.nom}`} width={48} height={48} class="h-12 w-12 rounded-full" loading="lazy" />
          <span class="font-serif text-xl font-semibold">{site.nom}</span>
        </a>
        <p class="mt-4 max-w-sm text-[0.95rem] leading-relaxed text-white/80">{site.nomLong}. {site.signature}.</p>
        <p class="mt-6 text-sm text-white/70">
          <a href={site.chefferie.url} rel="external" class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
            >{t('footer.chefferie')}</a
          >
        </p>
      </div>

      {
        colonnes.map((c) => (
          <div>
            <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{c.titre}</h2>
            <ul class="mt-4 space-y-1">
              {c.liens.map((l) => (
                <li>
                  <a href={l.href} class="inline-flex min-h-10 items-center text-[0.95rem] hover:underline">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="border-t border-white/15">
      <div class="wrap flex flex-col gap-4 py-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <Image src={logoRdc} alt={`Logo de ${site.partenaire.nom}`} width={36} height={36} class="h-9 w-9 rounded-sm" loading="lazy" />
          <span>
            {t('footer.partenaire')} :
            <a href={site.partenaire.url} rel="external" class="underline decoration-white/40 underline-offset-4 hover:decoration-white">{site.partenaire.nom}</a>
          </span>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          <li><a href="/charte-acces" class="inline-flex min-h-10 items-center hover:underline">{t('footer.charte')}</a></li>
          <li><a href="/mentions-legales" class="inline-flex min-h-10 items-center hover:underline">{t('footer.mentions')}</a></li>
          <li class="inline-flex min-h-10 items-center">© {site.edition.annee} {site.nom}</li>
        </ul>
      </div>
    </div>
  </div>
</footer>
